# macOS
.DS_Store
.AppleDouble
.LSOverride

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/
.python-version

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/

# uv
.uv/

# Graphify build cache (regenerated by `graphify update .`)
graphify-out/cache/
graphify-out/*.log
# Incremental-rebuild manifest: local mtimes + absolute paths, churns every run
graphify-out/manifest.json
graphify-out/*/manifest.json

# Obsidian local/device-specific state
llm-knowledge/.obsidian/workspace.json
llm-knowledge/.obsidian/workspace-mobile.json
llm-knowledge/.obsidian/plugins/*/data.json

# Claude Code local overrides (may contain secrets/machine-specific config)
.claude/settings.local.json

# Secrets / environment files
.env
.env.*
!.env.example

# Editor/IDE
.vscode/
.idea/

# Logs
*.log

