{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    ".opencode/plugins/graphify.js"
  ],
  "model": "litellm/gpt-5.6-luna",
  "mcp": {
    "perplexity": {
      "type": "remote",
      "url": "https://litellm.ai.viadee.cloud/mcp/websearch",
      "headers": {
        "x-litellm-api-key": "Bearer {env:LITE_LLM_API_KEY}"
      }
    }
  },
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM viadee",
      "options": {
        "baseURL": "https://litellm.ai.viadee.cloud/",
        "apiKey": "{env:LITE_LLM_API_KEY}"
      },
      "models": {
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol",
          "cost": {
            "input": 5.5,
            "output": 33,
            "cache_read": 0.55,
            "cache_write": 6.875
          }
        },
        "gpt-5.6-terra": {
